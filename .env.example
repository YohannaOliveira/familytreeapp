# Copie para .env e preencha. NUNCA versione o .env.
POSTGRES_DB=familytree
POSTGRES_USER=familytree
POSTGRES_PASSWORD=change-me

# --- Seguranca (backend) ---
# Usuario administrador unico.
ADMIN_USER=admin
# Hash BCrypt da senha (nunca a senha em texto). Gerar com:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'SUA_SENHA' | tr -d ':\n' | sed 's/$2y/$2a/'
# Em arquivos .env lidos pelo docker compose, escape cada "$" como "$$".
ADMIN_PASSWORD_HASH=
# Segredo de assinatura do JWT, minimo 32 caracteres. Gerar com: openssl rand -base64 48
JWT_SECRET=
# Validade do token (padrao 30m)
JWT_TTL=30m
# Origens do front permitidas no CORS, separadas por virgula
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Rate limit por IP (padroes): login 5/min, geral 300/min
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW=1m
API_MAX_REQUESTS=300
API_WINDOW=1m
# Em producao atras do proxy do Render, use "native" para o rate limit enxergar o IP real
FORWARD_HEADERS_STRATEGY=none
